# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.*.log
*.tsbuildinfo

# env files (can opt-in for committing if needed)
.env*
!deploy/vm/.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/.codex/
/backend/data/
/backend/coverage.out
/backend/zoomigo-api*

# Production deployment secrets live only in GitHub Actions secrets/variables;
# these guard against ever accidentally staging real credentials locally.
/deploy/secrets/plaintext/
/deploy/secrets/*.identity
/deploy/secrets/*.key
/deploy/secrets/*identity*
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfplan.sha
**/terraform.tfvars
**/*.auto.tfvars
/backend/*.exe
