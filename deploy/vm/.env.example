COMPOSE_PROJECT_NAME=stridecrew
# Copy the complete sha-* tag produced by the GitHub Actions backend-image workflow.
API_IMAGE=ghcr.io/dafepro/fc-workout-pwa/api:sha-REPLACE_WITH_FULL_GIT_SHA
APP_VERSION=REPLACE_WITH_FULL_GIT_SHA

# Public age X25519 recipient only. Keep the matching AGE-SECRET-KEY off the VM.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OPERATOR_PUBLIC_RECIPIENT
R2_UPLOAD_ENABLED=true
# Old local encrypted archives are pruned only after a successful R2 upload.
LOCAL_BACKUP_RETENTION_DAYS=7
# Keep false until every owner item in PRODUCTION_APPROVAL_CHECKLIST.md is recorded.
PRODUCTION_DATA_APPROVED=false

# A real DNS hostname whose A/AAAA record points at this VM. Do not include a scheme.
CADDY_SITE_ADDRESS=api.example.com

# The exact production Cloudflare Worker custom-domain origin. No trailing slash.
PWA_ORIGIN=https://app.example.com
TEAM_TIME_ZONE=America/Chicago

# Dedicated absolute host paths. prepare-host.sh creates these with mode 0700.
DATA_DIR=/var/lib/stridecrew/data
BACKUP_DIR=/var/backups/stridecrew
RESTORE_DIR=/var/lib/stridecrew/restore
ADMIN_OUTPUT_DIR=/var/lib/stridecrew/admin-output

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
