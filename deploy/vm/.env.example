COMPOSE_PROJECT_NAME=zoomigo
# Copy the complete sha-* tag produced by the GitHub Actions backend-image workflow.
API_IMAGE=ghcr.io/dafepro/fc-workout-pwa/api:sha-REPLACE_WITH_FULL_GIT_SHA
APP_VERSION=REPLACE_WITH_FULL_GIT_SHA

# Public age X25519 recipient only. Keep the matching AGE-SECRET-KEY off the VM.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OPERATOR_PUBLIC_RECIPIENT
BACKUP_S3_UPLOAD_ENABLED=true
# Old local encrypted archives are pruned only after a successful S3 upload.
LOCAL_BACKUP_RETENTION_DAYS=7
# Keep false until every owner item in PRODUCTION_APPROVAL_CHECKLIST.md is recorded.
PRODUCTION_DATA_APPROVED=false

# 32 base64-encoded bytes. Encrypts stored staff second factors; without it the
# API refuses staff sign-in rather than running without one. Rotating it makes
# every enrolled authenticator unreadable, so every staff account must re-enrol.
STAFF_SECRET_KEY=
# Absolute https URLs on the PWA hostname. The console builds a player's QR link
# and a coach's one-time setup link from these.
PLAYER_LOGIN_URL=https://app.example.com/login
STAFF_SETUP_URL=https://app.example.com/staff/setup
# Team Reward email stays non-delivering until the sending domain is verified.
REWARD_MAILER_MODE=sink
REWARD_EMAIL_FROM=ZoomiGo Rewards <rewards@notify.example.com>
REWARD_EMAIL_BASE_URL=https://app.example.com
RESEND_API_KEY=

# A real DNS hostname whose A/AAAA record points at this VM. Do not include a scheme.
CADDY_SITE_ADDRESS=api.example.com

# The exact production Cloudflare Worker custom-domain origin. No trailing slash.
PWA_ORIGIN=https://app.example.com
TEAM_TIME_ZONE=America/Chicago

# Dedicated absolute host paths. prepare-host.sh creates these with mode 0700.
DATA_DIR=/var/lib/zoomigo/data
BACKUP_DIR=/var/backups/zoomigo
RESTORE_DIR=/var/lib/zoomigo/restore
ADMIN_OUTPUT_DIR=/var/lib/zoomigo/admin-output

HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
