{
	admin off
}

{$CADDY_SITE_ADDRESS} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@team_world {
		path /room
		header X-Zoomigo-Dev-Gateway {$DEV_API_GATEWAY_TOKEN}
		header Upgrade websocket
	}
	reverse_proxy @team_world team-world:8795

	@team_lounge_realtime path /v1/realtime/rooms/*
	reverse_proxy @team_lounge_realtime {$CADDY_UPSTREAMS:api:8080} {
		health_uri /readyz
		lb_policy uri_hash
		lb_try_duration 5s
	}

	reverse_proxy {$CADDY_UPSTREAMS:api:8080} {
		health_uri /readyz
		lb_try_duration 5s
	}
}
