[Unit]
Description=Create and verify a ZoomiGo SQLite backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/app/deploy/vm/.env

[Service]
Type=oneshot
WorkingDirectory=/opt/app/deploy/vm
EnvironmentFile=-/etc/zoomigo/backup-s3.env
ExecStart=/opt/app/deploy/vm/scripts/backup.sh /opt/app/deploy/vm/.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
