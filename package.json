{
  "name": "zoomigo-pwa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prune-browser-only-server-assets.mjs",
    "start": "vinext start",
    "test": "vitest run",
    "test:e2e": "./scripts/e2e.sh",
    "test:e2e:visual": "./scripts/e2e-visual.sh",
    "test:e2e:visual:update": "./scripts/e2e-visual.sh --update-snapshots",
    "test:browser": "playwright test",
    "test:vm": "./scripts/vm-smoke.sh",
    "avatar:source": "node tools/avatar-content/create-engineering-sources.mjs",
    "avatar:build": "node tools/avatar-content/build-engineering-library.mjs && node tools/avatar-content/validate-engineering-library.mjs",
    "avatar:validate": "node tools/avatar-content/validate-engineering-library.mjs",
    "avatar:spec:validate": "node tools/avatar-content/validate-artist-spec.mjs",
    "verify:worker-upload": "node scripts/verify-worker-upload.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "verify": "./scripts/verify.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work --ignore-pattern outputs"
  },
  "dependencies": {
    "@canvas-physics/client": "file:vendor/canvas/canvas-physics-client-0.6.2.tgz",
    "@canvas-physics/core": "file:vendor/canvas/canvas-physics-core-0.6.2.tgz",
    "@canvas-physics/protocol": "file:vendor/canvas/canvas-physics-protocol-0.6.2.tgz",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "26.0.0",
    "meshoptimizer": "1.2.0",
    "prettier": "3.5.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "3.0.9",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
