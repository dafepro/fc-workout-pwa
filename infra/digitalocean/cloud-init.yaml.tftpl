#cloud-config
package_update: true
package_upgrade: false
packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - git
  - rclone
  - unattended-upgrades

users:
  - default
  - name: zoomigo
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
%{ if operator_ssh_public_key != "" }
      - ${operator_ssh_public_key}
%{ endif }

ssh_pwauth: false
disable_root: true

# Swap must be created by the swap module, not by bootcmd. cloud-init runs
# bootcmd in the init stage BEFORE growpart/resizefs, so on a fresh Droplet the
# root filesystem is still the image's 2.5G partition rather than the full 10G
# disk. "fallocate -l 1G" there fills the remaining ~640MB and dies with ENOSPC,
# leaving the disk 100% full and every later stage -- host key generation, user
# creation, write_files, packages, runcmd -- unable to run at all. The swap
# module is part of cc_mounts in the config stage, which runs after the root
# filesystem has been grown, so there is room by then.
swap:
  filename: /swapfile
  size: 1G
  maxsize: 1G

write_files:
  - path: /etc/ssh/sshd_config.d/90-zoomigo.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
  - path: /tmp/zoomigo-production.env
    owner: root:root
    permissions: "0600"
    content: |
      ${environment_file}

runcmd:
  - [systemctl, enable, --now, docker]
  - [systemctl, enable, --now, apt-daily.timer, apt-daily-upgrade.timer]
  - [install, -d, -m, "0755", -o, zoomigo, -g, zoomigo, /opt/app]
  - [sudo, -u, zoomigo, git, clone, --no-checkout, ${repository_url}, /opt/app]
  - [sudo, -u, zoomigo, git, -C, /opt/app, fetch, --depth=1, origin, ${release_sha}]
  - [sudo, -u, zoomigo, git, -C, /opt/app, checkout, --detach, ${release_sha}]
  - [install, -m, "0600", -o, zoomigo, -g, zoomigo, /tmp/zoomigo-production.env, /opt/app/deploy/vm/.env]
  - [rm, -f, /tmp/zoomigo-production.env]
  - [/opt/app/deploy/vm/scripts/prepare-host.sh, /opt/app/deploy/vm/.env]
  - [/opt/app/deploy/vm/scripts/install-backup-service.sh]
  - [systemctl, restart, ssh]
  - [touch, /var/lib/zoomigo/BOOTSTRAP_COMPLETE]
  - [chmod, "0600", /var/lib/zoomigo/BOOTSTRAP_COMPLETE]

final_message: "ZoomiGo host bootstrap completed; cloud-init status is ready."
